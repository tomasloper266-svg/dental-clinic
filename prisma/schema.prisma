// مخطط قاعدة البيانات — نظام إدارة عيادات الأسنان (v1)
// القاعدة الإلزامية: كل جدول سريري أو مالي أو مخزني يحمل clinicId مع فهارس مركّبة —
// العزل يتم عبر سياق العيادة (انظر lib/tenant) وليس عبر هذا الملف وحده.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── التعدادات ────────────────────────────────────────────────────────────────

enum UserRole {
  DENTIST
  ASSISTANT
}

// حالات الموعد المحكومة — الانتقالات المسموحة تُفحص في طبقة الخدمة
enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_TREATMENT
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum WaitlistStatus {
  WAITING
  OFFERED
  BOOKED
}

// نوع مشاهدة السن: موجودة / تشخيص / علاج منجز — لا تُستبدل الواحدة بالأخرى
enum ToothFindingKind {
  EXISTING
  DIAGNOSIS
  TREATMENT_DONE
}

enum ToothStatus {
  HEALTHY
  DECAYED
  FILLED
  ROOT_CANAL
  EXTRACTED
  CROWN
  IMPLANT
  WATCH
}

enum TreatmentItemStatus {
  PROPOSED
  ACCEPTED
  DONE
}

// أنواع قيود الدفتر المالي — الرصيد يُحسب من القيود دائماً ولا يُخزَّن
enum LedgerEntryType {
  CHARGE
  PAYMENT
  ADJUSTMENT
  REFUND
}

// ─── العيادة والمستخدمون والجلسات ────────────────────────────────────────────

model Clinic {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users                User[]
  patients             Patient[]
  appointments         Appointment[]
  waitlistEntries      WaitlistEntry[]
  toothFindings        ToothFinding[]
  treatmentPlanItems   TreatmentPlanItem[]
  ledgerEntries        LedgerEntry[]
  expenses             Expense[]
  materials            Material[]
  materialUsages       MaterialUsage[]
  instructionTemplates InstructionTemplate[]
}

model User {
  id           String   @id @default(cuid())
  clinicId     String
  name         String
  phone        String
  passwordHash String
  role         UserRole @default(DENTIST)
  createdAt    DateTime @default(now())

  clinic                Clinic          @relation(fields: [clinicId], references: [id])
  sessions              Session[]
  recordedFindings      ToothFinding[]  @relation("FindingRecorder")
  createdLedgerEntries  LedgerEntry[]   @relation("LedgerEntryCreator")
  recordedMaterialUsage MaterialUsage[] @relation("MaterialUsageRecorder")

  @@unique([clinicId, phone])
  @@index([clinicId])
}

// الجلسات مخزّنة في القاعدة — كوكي يحمل توكيناً عشوائياً ويُخزَّن هاشه فقط
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── المرضى ──────────────────────────────────────────────────────────────────

model Patient {
  id           String   @id @default(cuid())
  clinicId     String
  name         String
  birthYear    Int?
  phone        String?
  address      String?
  medicalNotes String?
  createdAt    DateTime @default(now())

  clinic             Clinic              @relation(fields: [clinicId], references: [id])
  appointments       Appointment[]
  waitlistEntries    WaitlistEntry[]
  toothFindings      ToothFinding[]
  treatmentPlanItems TreatmentPlanItem[]
  ledgerEntries      LedgerEntry[]

  @@index([clinicId, name])
  @@index([clinicId, phone])
}

// ─── المواعيد وقائمة الانتظار ────────────────────────────────────────────────

model Appointment {
  id          String            @id @default(cuid())
  clinicId    String
  patientId   String
  startsAt    DateTime
  durationMin Int               @default(30)
  status      AppointmentStatus @default(SCHEDULED)
  reason      String?
  note        String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  clinic         Clinic          @relation(fields: [clinicId], references: [id])
  patient        Patient         @relation(fields: [patientId], references: [id])
  materialUsages MaterialUsage[]

  @@index([clinicId, startsAt])
  @@index([clinicId, patientId, startsAt])
}

model WaitlistEntry {
  id              String         @id @default(cuid())
  clinicId        String
  patientId       String
  preferredWindow String
  priority        Int            @default(0)
  status          WaitlistStatus @default(WAITING)
  note            String?
  createdAt       DateTime       @default(now())

  clinic  Clinic  @relation(fields: [clinicId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])

  @@index([clinicId, status, priority])
}

// ─── مخطط الأسنان (ترقيم FDI: 11–48) ────────────────────────────────────────

model ToothFinding {
  id           String           @id @default(cuid())
  clinicId     String
  patientId    String
  toothFdi     Int
  kind         ToothFindingKind
  status       ToothStatus
  surface      String?
  note         String?
  recordedById String
  recordedAt   DateTime         @default(now())

  clinic     Clinic  @relation(fields: [clinicId], references: [id])
  patient    Patient @relation(fields: [patientId], references: [id])
  recordedBy User    @relation("FindingRecorder", fields: [recordedById], references: [id])

  @@index([clinicId, patientId, toothFdi])
}

model TreatmentPlanItem {
  id        String              @id @default(cuid())
  clinicId  String
  patientId String
  toothFdi  Int
  procedure String
  priceSyp  Int
  status    TreatmentItemStatus @default(PROPOSED)
  priority  Int                 @default(0)

  clinic  Clinic  @relation(fields: [clinicId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])

  @@index([clinicId, patientId, status])
}

// ─── الحسابات (دفتر غير قابل للتعديل — التصحيح بقيد عكسي) ───────────────────

model LedgerEntry {
  id          String          @id @default(cuid())
  clinicId    String
  patientId   String
  type        LedgerEntryType
  amountSyp   Int
  note        String?
  createdById String
  createdAt   DateTime        @default(now())

  clinic    Clinic  @relation(fields: [clinicId], references: [id])
  patient   Patient @relation(fields: [patientId], references: [id])
  createdBy User    @relation("LedgerEntryCreator", fields: [createdById], references: [id])

  @@index([clinicId, patientId, createdAt])
}

// ─── مصاريف العيادة ──────────────────────────────────────────────────────────

model Expense {
  id        String   @id @default(cuid())
  clinicId  String
  category  String
  amountSyp Int
  note      String?
  spentAt   DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([clinicId, spentAt])
}

// ─── المخزون ─────────────────────────────────────────────────────────────────

model Material {
  id             String  @id @default(cuid())
  clinicId       String
  name           String
  unit           String
  quantityOnHand Decimal @default(0) @db.Decimal(12, 2)
  minQuantity    Decimal @default(0) @db.Decimal(12, 2)
  costSyp        Int?

  clinic         Clinic          @relation(fields: [clinicId], references: [id])
  materialUsages MaterialUsage[]

  @@index([clinicId, name])
}

model MaterialUsage {
  id              String   @id @default(cuid())
  clinicId        String
  materialId      String
  quantityUsed    Decimal  @db.Decimal(12, 2)
  treatmentItemId String?
  appointmentId   String?
  recordedById    String
  createdAt       DateTime @default(now())

  clinic      Clinic       @relation(fields: [clinicId], references: [id])
  material    Material     @relation(fields: [materialId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  recordedBy  User         @relation("MaterialUsageRecorder", fields: [recordedById], references: [id])

  @@index([clinicId, materialId, createdAt])
}

// ─── قوالب تعليمات ما بعد الجراحة ────────────────────────────────────────────

model InstructionTemplate {
  id        String @id @default(cuid())
  clinicId  String
  procedure String
  body      String

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([clinicId, procedure])
}
