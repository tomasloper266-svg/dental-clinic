// مخطط قاعدة البيانات — نظام إدارة عيادات الأسنان (v1)
// القاعدة الإلزامية: كل جدول سريري أو مالي أو مخزني يحمل clinicId مع فهارس مركّبة —
// العزل يتم عبر سياق العيادة (انظر lib/tenant) وليس عبر هذا الملف وحده.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── التعدادات ────────────────────────────────────────────────────────────────

enum UserRole {
  DENTIST
  ASSISTANT
}

// حالات الموعد المحكومة — الانتقالات المسموحة تُفحص في طبقة الخدمة
enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_TREATMENT
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum WaitlistStatus {
  WAITING
  OFFERED
  BOOKED
}

// نوع مشاهدة السن: موجودة / تشخيص / علاج منجز — لا تُستبدل الواحدة بالأخرى
enum ToothFindingKind {
  EXISTING
  DIAGNOSIS
  TREATMENT_DONE
}

enum ToothStatus {
  HEALTHY
  DECAYED
  FILLED
  ROOT_CANAL
  EXTRACTED
  CROWN
  IMPLANT
  WATCH
  BROKEN
  SENSITIVITY
}

enum TreatmentItemStatus {
  PROPOSED
  ACCEPTED
  DONE
}

// أنواع قيود الدفتر المالي — الرصيد يُحسب من القيود دائماً ولا يُخزَّن
enum LedgerEntryType {
  CHARGE
  PAYMENT
  ADJUSTMENT
  REFUND
}

// قناة إرسال تعليمات ما بعد الجراحة — رابط واتساب أو نسخة نصية
enum InstructionChannel {
  WHATSAPP
  TEXT
}

// غرض رمز التحقق — يحدد ما يصرح به الرمز حصراً
enum VerificationPurpose {
  PASSWORD_RESET
  EMAIL_VERIFICATION
  PHONE_RECOVERY
}

// قناة إيصال رموز التحقق — عبر موفّر خارجي قابل للربط (انظر lib/notifications)
enum NotificationChannel {
  SMS
  EMAIL
}

// نوع الجنس — لعرض القائمة بأيقونتي ذكر/أنثى وللتبويب حسب الجنس
enum Gender {
  MALE
  FEMALE
}

enum SupportRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

// أدوار الطاقم — التسميات العربية للعرض في lib/services/staff.ts
enum StaffRole {
  DENTIST
  RECEPTION
  ASSISTANT
  ACCOUNTANT
}

// ─── العيادة والمستخدمون والجلسات ────────────────────────────────────────────

model Clinic {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  // سعر صرف الدولار بالليرة السورية — أساس عرض العملة المزدوجة ($ + ل.س).
  // قيمة موجبة يتجاوز الصفر، تُعدَّل من إعدادات العيادة فقط.
  usdRate   Float    @default(15000)

  // إعدادات العيادة العامة — تُعدَّل من صفحة الإعدادات حصراً.
  // العملة المعروضة: USD يعرض الدولار أساسياً والليرة بين قوسين، والعكس مع SYP.
  currency       String @default("USD")
  // حرف الشعار — الحرف الظاهر في مربع السايدبار، ويُفسر من اسم العيادة إن غاب.
  logoLetter     String @default("")
  // رصيد الافتتاحي بالليرة السورية — وحدة تخزين المبالغ في النظام كلها.
  openingBalance Float  @default(0)
  // ساعات العمل بصيغة 12 ساعة — «09:00 AM» حتى «09:00 PM».
  workStart      String @default("09:00 AM")
  workEnd        String @default("09:00 PM")

  users                User[]
  patients             Patient[]
  appointments         Appointment[]
  waitlistEntries      WaitlistEntry[]
  appointmentStatusChanges AppointmentStatusChange[]
  toothFindings        ToothFinding[]
  treatmentPlanItems   TreatmentPlanItem[]
  treatmentPlans       TreatmentPlan[]
  ledgerEntries        LedgerEntry[]
  expenses             Expense[]
  materials            Material[]
  materialUsages       MaterialUsage[]
  instructionTemplates InstructionTemplate[]
  instructionSends     InstructionSend[]
  appointmentReminders AppointmentReminder[]
  staffMembers         StaffMember[]
  materialMovements    MaterialMovement[]
  backups              ClinicBackup[]
}

// نسخة احتياطية تلقائية أو يدوية (JSON) — آخر نسخة تلقائية فقط تُحفظ للعيادة،
// والاستعادة تعيد البيانات التشغيلية دون حسابات الدخول.
enum BackupKind {
  AUTO
  MANUAL
}

model ClinicBackup {
  id        String     @id @default(cuid())
  clinicId  String
  kind      BackupKind @default(AUTO)
  payload   Json
  createdAt DateTime   @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, kind, createdAt])
}

model User {
  id           String   @id @default(cuid())
  clinicId     String
  name         String
  phone        String
  passwordHash String
  role         UserRole @default(DENTIST)
  createdAt    DateTime @default(now())

  // حقول الاستعادة — البريد يُخزَّن بعد التحقق منه فقط (OTP)، ورمز الاسترداد
  // يُنشأ عند التسجيل ويُعرض مرة واحدة وتُخزَّن هاشته فقط.
  email           String?
  emailVerifiedAt DateTime?
  recoveryCodeHash String?

  // قفل التطبيق — لكل حساب مستقله (كقفل الهاتف): الحالة وهاش الرمز الرقمي.
  // الرمز نفسه لا يُخزَّن أبداً — هاشه فقط، وصفحة الإعدادات تُعيده ولا تعرضه.
  lockEnabled Boolean @default(false)
  lockPinHash String?

  clinic                Clinic          @relation(fields: [clinicId], references: [id])
  sessions              Session[]
  otpTokens             VerificationToken[]
  recordedFindings      ToothFinding[]  @relation("FindingRecorder")
  createdLedgerEntries  LedgerEntry[]   @relation("LedgerEntryCreator")
  recordedMaterialUsage MaterialUsage[] @relation("MaterialUsageRecorder")
  appointmentStatusChanges AppointmentStatusChange[] @relation("AppointmentStatusChanger")
  sentInstructions      InstructionSend[] @relation("InstructionSender")
  sentReminders         AppointmentReminder[] @relation("ReminderSender")

  @@unique([clinicId, phone])
  @@index([clinicId])
  @@index([email])
}

// الجلسات مخزّنة في القاعدة — كوكي يحمل توكيناً عشوائياً ويُخزَّن هاشه فقط
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// رموز تحقق مرة واحدة (OTP) — تُخزَّن مُهشَّرة، لكل غرض وقناة، واستهلاك واحد.
// إنشاء رمز جديد لنفس الغرض يُبطل الرموز السابقة غير المستهلكة.
model VerificationToken {
  id          String               @id @default(cuid())
  userId      String
  purpose     VerificationPurpose
  channel     NotificationChannel
  destination String
  codeHash    String
  expiresAt   DateTime
  attempts    Int                  @default(0)
  consumedAt  DateTime?
  createdAt   DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
}

// طلبات الدعم من غير المسجلين — «نسيت رقم الهاتف» بلا بريد موثق ينتهي هنا.
model SupportRequest {
  id           String               @id @default(cuid())
  clinicName   String
  contactEmail String?
  contactPhone String?
  message      String
  status       SupportRequestStatus @default(OPEN)
  createdAt    DateTime             @default(now())
}

// ─── المرضى ──────────────────────────────────────────────────────────────────

model Patient {
  id           String   @id @default(cuid())
  clinicId     String
  name         String
  birthYear    Int?
  phone        String?
  address      String?
  medicalNotes String?
  createdAt    DateTime @default(now())

  // حقول الهوية والاتصال الموسّعة — كلها اختيارية حفاظاً على البيانات القائمة
  gender          Gender?
  secondaryPhone  String?
  homePhone       String?
  email           String?
  nationalId      String?
  bloodType       String?
  allergies       String?
  chronicDiseases String?
  emergencyContacts String?
  // رقم الأيوبي (رقم الملف) — تسلسل تلقائي داخل العيادة يُعرَض في القائمة
  // ويُبحث به؛ يُنشأ عند التسجيل ولا يُعاد ترقيمه أبداً.
  fileNo          Int?

  clinic             Clinic              @relation(fields: [clinicId], references: [id])
  appointments       Appointment[]
  waitlistEntries    WaitlistEntry[]
  toothFindings      ToothFinding[]
  treatmentPlanItems TreatmentPlanItem[]
  treatmentPlans     TreatmentPlan[]
  ledgerEntries      LedgerEntry[]
  materialUsages     MaterialUsage[]
  instructionSends   InstructionSend[]

  @@index([clinicId, name])
  @@index([clinicId, phone])
  @@unique([clinicId, fileNo])
}

// ─── المواعيد وقائمة الانتظار ────────────────────────────────────────────────

model Appointment {
  id          String            @id @default(cuid())
  clinicId    String
  patientId   String
  startsAt    DateTime
  durationMin Int               @default(30)
  status      AppointmentStatus @default(SCHEDULED)
  reason      String?
  note        String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  // ربط اختياري بالطبيب المسند — فلتر الأطباء في لوحة المواعيد وعرضه على البطاقة
  staffId     String?

  clinic         Clinic          @relation(fields: [clinicId], references: [id])
  patient        Patient         @relation(fields: [patientId], references: [id])
  staff          StaffMember?    @relation(fields: [staffId], references: [id])
  materialUsages MaterialUsage[]
  statusChanges  AppointmentStatusChange[]
  reminders      AppointmentReminder[]

  @@index([clinicId, startsAt])
  @@index([clinicId, patientId, startsAt])
  @@index([clinicId, staffId, startsAt])
}

// ─── الطاقم ──────────────────────────────────────────────────────────────────
// بطاقات الطاقم مستقلة عن حسابات الدخول (User) — الطبيب هنا كيان جدولة
// وعمولة، وقد لا يحسب مسجلاً أصلاً. الحذف يفصل مواعيده (ON DELETE SET NULL)
// فلا تُفقد أي موعد عند رحيل عضو الطاقم.

model StaffMember {
  id                String    @id @default(cuid())
  clinicId          String
  name              String
  role              StaffRole @default(DENTIST)
  specialty         String?
  phone             String?
  commissionPercent Float     @default(0)
  colorHex          String    @default("#d4af37")
  scheduleNote      String?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  appointments Appointment[]
  // قيود الرسوم المُسندة لهذا الطبيب — إسناد محفوظ لحظة القيد.
  ledgerEntries LedgerEntry[]

  @@index([clinicId, name])
}

// سجل إرسال تذكير واتساب لموعد — سطر واحد لكل موعد أُرسل بضغطة. سطر الإرسال
// إلحاقي (لا يُعدَّل ولا يُحذف من طبقة الخدمة) والقيد المركّب يمنع التسجيل المزدوج
// ويجعل الصفحة تتذكر ما أُرسل بين الجلسات.
model AppointmentReminder {
  id            String   @id @default(cuid())
  clinicId      String
  appointmentId String
  sentById      String
  sentAt        DateTime @default(now())

  clinic      Clinic      @relation(fields: [clinicId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  sentBy      User        @relation("ReminderSender", fields: [sentById], references: [id])

  @@unique([clinicId, appointmentId])
  @@index([clinicId, sentAt])
}

// سجل تغيّر حالة الموعد — من الحالة إلى الحالة، ومَن غيّر ومتى.
// إلحاقي فقط: لا تعديل ولا حذف من طبقة الخدمة.
model AppointmentStatusChange {
  id            String            @id @default(cuid())
  clinicId      String
  appointmentId String
  fromStatus    AppointmentStatus
  toStatus      AppointmentStatus
  changedById   String
  createdAt     DateTime          @default(now())

  clinic      Clinic      @relation(fields: [clinicId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  changedBy   User        @relation("AppointmentStatusChanger", fields: [changedById], references: [id])

  @@index([clinicId, appointmentId, createdAt])
}

model WaitlistEntry {
  id              String         @id @default(cuid())
  clinicId        String
  patientId       String
  preferredWindow String
  priority        Int            @default(0)
  status          WaitlistStatus @default(WAITING)
  note            String?
  createdAt       DateTime       @default(now())

  clinic  Clinic  @relation(fields: [clinicId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])

  @@index([clinicId, status, priority])
}

// ─── مخطط الأسنان (ترقيم FDI: 11–48) ────────────────────────────────────────

model ToothFinding {
  id           String           @id @default(cuid())
  clinicId     String
  patientId    String
  toothFdi     Int
  kind         ToothFindingKind
  status       ToothStatus
  surface      String?
  note         String?
  recordedById String
  recordedAt   DateTime         @default(now())

  clinic     Clinic  @relation(fields: [clinicId], references: [id])
  patient    Patient @relation(fields: [patientId], references: [id])
  recordedBy User    @relation("FindingRecorder", fields: [recordedById], references: [id])

  @@index([clinicId, patientId, toothFdi])
}

// ─── خطط العلاج — كيان خطة يحتوي بنوداً، وبدونه البنود عناصر غير مخططة ───────

model TreatmentPlan {
  id        String   @id @default(cuid())
  clinicId  String
  patientId String
  name       String
  planDate   DateTime @default(now())
  doctorName String?
  notes      String?
  // نهاية الخطة — null يعني نشطة؛ «إنهاء الخطة» يطابع هذا الحقل
  endedAt   DateTime?
  createdAt DateTime @default(now())

  clinic  Clinic             @relation(fields: [clinicId], references: [id])
  patient Patient            @relation(fields: [patientId], references: [id])
  items   TreatmentPlanItem[]

  @@index([clinicId, patientId])
}

model TreatmentPlanItem {
  id        String              @id @default(cuid())
  clinicId  String
  patientId String
  // ربط اختياري بخطة — البنود بلا خطة تظهر «بدون خطة محفوظة»
  planId    String?
  toothFdi  Int
  procedure String
  priceSyp  Int
  status    TreatmentItemStatus @default(PROPOSED)
  priority  Int                 @default(0)

  clinic  Clinic         @relation(fields: [clinicId], references: [id])
  patient Patient        @relation(fields: [patientId], references: [id])
  plan    TreatmentPlan? @relation(fields: [planId], references: [id])

  @@index([clinicId, patientId, status])
  @@index([planId])
}

// ─── الحسابات (دفتر غير قابل للتعديل — التصحيح بقيد عكسي) ───────────────────

model LedgerEntry {
  id          String          @id @default(cuid())
  clinicId    String
  patientId   String
  type        LedgerEntryType
  amountSyp   Int
  note        String?
  createdById String
  createdAt   DateTime @default(now())
  // ربط اختياري ببند خطة علاج — لقيد الرسوم التلقائي عند اكتمال العلاج.
  // فريد: البند الواحد له قيد رسوم واحد حصراً — حاجز التكرار الأخير تحت الخدمة.
  treatmentItemId String? @unique
  // تسلسل الرسوم على مستوى العيادة — رقم الفاتورة يُشتق منه كي لا يتكرر
  // بين المرضى. فارغ للقيود السابقة على إضافته (يُرقّم موضعياً كالسابق).
  invoiceSeq Int?
  // الطبيب المُسند للقيد — يُملأ لحظة إنشاء قيد الرسوم من طبيب الموعد المُسند،
  // وقيمته محفوظة فتُقدَّم على أي استنتاج احتياجي في تقارير الإيراد. اختياري
  // للقيود القديمة، وحذف عضو الطاقم يفصل القيود (SET NULL) فلا يُحذف أي قيد.
  doctorId String?
  // ترشيح تخصيص الدفعة لفاتورة — للعرض في واجهة الفواتير حصراً ولا يدخل في
  // معادلة الرصيد إطلاقاً (التخصيص الزمني FIFO يبقى هو المعتمد محاسبياً).
  // RESTRICT: لا يُحذف قيد رسوم يشير إليه سطر دفعات — الدفتر إلحاقي.
  appliedChargeId String?

  clinic    Clinic  @relation(fields: [clinicId], references: [id])
  patient   Patient @relation(fields: [patientId], references: [id])
  createdBy User    @relation("LedgerEntryCreator", fields: [createdById], references: [id])
  doctor    StaffMember? @relation(fields: [doctorId], references: [id])
  appliedCharge LedgerEntry?  @relation("LedgerEntryAppliedCharge", fields: [appliedChargeId], references: [id], onDelete: Restrict)
  appliedPayments LedgerEntry[] @relation("LedgerEntryAppliedCharge")
  items LedgerEntryItem[]

  @@index([clinicId, patientId, createdAt])
  @@index([clinicId, treatmentItemId])
  @@index([doctorId])
  @@unique([clinicId, invoiceSeq])
}

// بنود الفاتورة — تفصيل قيد الرسوم: مجموع البنود يجب أن يساوي مبلغ القيد
// (تحقق صارم في الخدمة). تُنشأ من بند الخطة عند القيد التلقائي وتُدخل يدوياً
// في نموذج الفاتورة؛ القيد اليدوي المفرد بلا بنود مقبول. تُحذف مع قيدها.
model LedgerEntryItem {
  id          String @id @default(cuid())
  entryId     String
  description String
  // تصنيف نصي حُرّ — أساس تجميع الإيراد حسب نوع العلاج للفواتير المباشرة.
  category    String?
  amountSyp   Int
  sort        Int    @default(0)

  entry LedgerEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
}

// ─── مصاريف العيادة ──────────────────────────────────────────────────────────

model Expense {
  id        String   @id @default(cuid())
  clinicId  String
  category  String
  amountSyp Int
  note      String?
  spentAt   DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([clinicId, spentAt])
}

// ─── المخزون ─────────────────────────────────────────────────────────────────

model Material {
  id             String  @id @default(cuid())
  clinicId       String
  name           String
  unit           String
  // الفئة والمورد — وصيانة اختيارية للعرض في جدول المخزون ونوافذ التعديل
  category       String?
  supplier       String?
  quantityOnHand Decimal @default(0) @db.Decimal(12, 2)
  minQuantity    Decimal @default(0) @db.Decimal(12, 2)
  // التكلفة بعشرية ثابتة (12,2) — أسعار كسورية لا تُقرَّب عند التخزين أو العرض.
  costSyp        Decimal? @db.Decimal(12, 2)

  clinic         Clinic            @relation(fields: [clinicId], references: [id])
  materialUsages MaterialUsage[]
  movements      MaterialMovement[]

  @@index([clinicId, name])
}

// حركات المخزون — دفتر إلحاقي لكل تغيّر كمية: التوريد موجب، والاستعمال والتعديل
// اليدوي سالب. الرصيد الحالي يبقى في Material.quantityOnHand حصراً، والدفتر
// لسجل «السجل» ومراجعة التغييرات — لا يُعدَّل ولا يُحذف من طبقة الخدمة.
model MaterialMovement {
  id             String   @id @default(cuid())
  clinicId       String
  materialId     String
  quantityChange Decimal  @db.Decimal(12, 2)
  note           String?
  recordedById   String
  // تاريخ الحركة كما أدخله المستخدم (توريد سابق بتاريخ فاتورة مثلاً) — الافتراض الآن
  movedAt        DateTime @default(now())

  clinic   Clinic   @relation(fields: [clinicId], references: [id])
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([clinicId, materialId, movedAt])
  @@index([clinicId, movedAt])
}

model MaterialUsage {
  id              String   @id @default(cuid())
  clinicId        String
  materialId      String
  quantityUsed    Decimal  @db.Decimal(12, 2)
  patientId       String?
  treatmentItemId String?
  appointmentId   String?
  recordedById    String
  createdAt       DateTime @default(now())

  clinic      Clinic       @relation(fields: [clinicId], references: [id])
  material    Material     @relation(fields: [materialId], references: [id])
  patient     Patient?     @relation(fields: [patientId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  recordedBy  User         @relation("MaterialUsageRecorder", fields: [recordedById], references: [id])

  @@index([clinicId, materialId, createdAt])
}

// ─── قوالب تعليمات ما بعد الجراحة ────────────────────────────────────────────

model InstructionTemplate {
  id        String @id @default(cuid())
  clinicId  String
  procedure String
  body      String

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([clinicId, procedure])
}

// سجل ما أُرسل للمريض من تعليمات — إلحاقي فقط: لا تعديل ولا حذف من طبقة
// الخدمة. يخزّن نص التعليمات كما أُرسل ليبقى التاريخ صحيحاً حتى لو تعدّل القالب.
model InstructionSend {
  id         String             @id @default(cuid())
  clinicId   String
  patientId  String
  templateId String?
  procedure  String
  body       String
  channel    InstructionChannel
  sentById   String
  sentAt     DateTime           @default(now())

  clinic  Clinic  @relation(fields: [clinicId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])
  sentBy  User    @relation("InstructionSender", fields: [sentById], references: [id])

  @@index([clinicId, patientId, sentAt])
}
